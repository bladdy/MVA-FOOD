---
export interface Props {
  name: string;
  description: string;
  url: string;
}

const { name, description, url } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name,
  description,
  url,
};
---
<script type="application/ld+json" set:html={JSON.stringify(data)}></script>
