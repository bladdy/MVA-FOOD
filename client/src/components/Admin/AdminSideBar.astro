---
import Home from "@assets/svg/home.svg";
import Food from "@assets/svg/tools-kitchen-3.svg";
import Settings from "@assets/svg/settings.svg";
import List from "@assets/svg/list.svg";
import ListAdd from "@assets/svg/list-add.svg";
import LogoutButton from "@/React/Auth/LogoutButton";
import TruckDelivery from "@assets/svg/truck-delivery.svg";

---

<aside
  id="sidebar"
  class="bg-gradient-to-br from-gray-800 to-gray-900 fixed inset-y-0 left-0 z-50 my-4 ml-4 h-[calc(100vh-32px)]
  w-72 rounded-xl transform -translate-x-full opacity-0 pointer-events-none transition-all duration-300 lg:translate-x-0 lg:opacity-100 lg:pointer-events-auto flex flex-col justify-between"
>
  <!-- 🔹 Header con logo y botón cerrar -->
  <div>
    <div class="relative border-b border-white/20">
      <div class="flex justify-between items-center">
        <a class="flex items-center gap-2 px-8 py-6">
          <img src="/mr_menus_no.png" alt="Mr. Menus" class="h-14 mr-2" />
          <h6 class="font-semibold text-white">Mr. Menús</h6>
        </a>
        <div class="p-4 lg:hidden">
          <button
            id="sidebar-close"
            class="p-4 text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 rounded-full"
          >
            ✕
          </button>
        </div>
      </div>
    </div>

    <!-- 🔹 Menú principal -->
    <div class="m-4">
      <ul class="flex flex-col gap-1 mb-4 text-white">
        <li>
          <a href="/admin/dashboard" class="flex items-center gap-4 px-4 py-3 text-white rounded-lg hover:bg-white/10">
            <Home class="text-sm mr-2" />
            <p class="text-base font-medium">Dashboard</p>
          </a>

          <!-- Dropdown Menus -->
          <div class="relative">
            <button
              id="menu-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <List class="text-sm mr-2" />
              <p class="text-base font-medium">Menus</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="menu-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/menus/platos" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <Food class="text-sm mr-2" />
                  Platos
                </a>
              </li>
              <li>
                <a href="/admin/menus/variantes" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <ListAdd class="text-sm mr-2" />
                  Variantes
                </a>
              </li>
              <li>
                <a href="/admin/combos" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  Combos
                </a>
              </li>
            </ul>
          </div>

          <!-- Dropdown Ordenes -->
          <div class="relative">
            <button
              id="ordenes-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <TruckDelivery class="text-sm mr-2" />
              <p class="text-base font-medium">Órdenes</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="ordenes-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/ordenes/ordenes" class="flex items-center gap-4 px-4 py-2 pl-8 text-white rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                  <p class="text-sm font-medium">Órdenes</p>
                </a>
              </li>
              <li>
                <a href="/admin/ordenes/historial" class="flex items-center gap-4 px-4 py-2 pl-8 text-white rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Historial
                </a>
              </li>
            </ul>
          </div>

          <!-- Dropdown Facturación (POS) -->
          <div class="relative">
            <button
              id="facturacion-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              <p class="text-base font-medium">Facturación</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="facturacion-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/facturacion/ventas" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  </svg>
                  Punto de venta
                </a>
              </li>
              <li>
                <a href="/admin/facturacion/reporte" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                  Reporte de ventas
                </a>
              </li>
              <li>
                <a href="/admin/facturacion/facturas" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                  Facturas
                </a>
              </li>
            </ul>
          </div>

          <!-- Dropdown Suscripción -->
          <div class="relative">
            <button
              id="suscripcion-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <p class="text-base font-medium">Suscripción</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="suscripcion-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/facturacion" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Mi suscripción
                </a>
              </li>
              <li>
                <a href="/admin/facturacion/historial" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Historial
                </a>
              </li>
              <li>
                <a href="/admin/facturacion/planes" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  Planes
                </a>
              </li>
            </ul>
          </div>

          <!-- Dropdown Servicio (mesero + cocina) -->
          <div class="relative">
            <button
              id="servicio-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m-3.536-3.536a4.5 4.5 0 010-5.657M12 2v4m0 12v4M2 12h4m12 0h4" />
              </svg>
              <p class="text-base font-medium">Servicio</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="servicio-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/mesero" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5v14" />
                  </svg>
                  Mesero
                </a>
              </li>
              <li>
                <a href="/admin/cocina" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                  Cocina
                </a>
              </li>
            </ul>
          </div>

          <!-- Dropdown Configuración -->
          <div class="relative">
            <button
              id="config-toggle"
              class="flex items-center gap-4 px-4 py-3 w-full text-white rounded-lg hover:bg-white/10 focus:outline-none"
            >
              <Settings class="text-sm mr-2" />
              <p class="text-base font-medium">Configuración</p>
              <svg
                class="ml-auto h-4 w-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul
              id="config-dropdown"
              class="hidden flex-col mt-1 text-white"
            >
              <li>
                <a href="/admin/configuracion/perfil" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  Perfil
                </a>
              </li>
              <li>
                    <a href="/admin/configuracion/tipos-de-entrega" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Tipos de entrega
                  </a>
                </li>
                <li>
                   <a href="/admin/configuracion/metodos-de-pago" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    Métodos de pago
                  </a>
              </li>
              <li>
                    <a href="/admin/configuracion/qr" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" />
                      <path d="M7 17l0 .01" />
                      <path d="M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" />
                      <path d="M7 7l0 .01" />
                      <path d="M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" />
                      <path d="M17 7l0 .01" /><path d="M14 14l3 0" />
                      <path d="M20 14l0 .01" /><path d="M14 14l0 3" />
                      <path d="M14 20l3 0" /><path d="M17 17l3 0" />
                      <path d="M20 17l0 3" />
                    </svg>
                      Generar QR
                  </a>
              </li>
              <li>
                <a href="/admin/mesas" class="flex items-center px-4 py-2 pl-8 text-sm rounded-lg hover:bg-white/10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="text-sm mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 6v6a2 2 0 002 2h14a2 2 0 002-2V6M3 12v6m18-6v6" />
                  </svg>
                  Mesas
                </a>
              </li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>
  <!-- 🔹 Botón Cerrar sesión solo en móviles -->
  <div class="m-4">
    <!-- 🔹 Botón cerrar sesión -->
    <LogoutButton client:load isSide={false}/>
  </div>

</aside>

<!-- 🔹 Scripts -->
<script>
  const sidebar = document.getElementById("sidebar");
  const openBtn = document.getElementById("sidebar-open");
  const closeBtn = document.getElementById("sidebar-close");

  openBtn?.addEventListener("click", () => {
    if (sidebar) {
      sidebar.classList.remove("-translate-x-full", "opacity-0", "pointer-events-none");
      sidebar.classList.add("translate-x-0", "opacity-100", "pointer-events-auto");
    }
  });

  closeBtn?.addEventListener("click", () => {
    if (sidebar) {
      sidebar.classList.remove("translate-x-0", "opacity-100", "pointer-events-auto");
      sidebar.classList.add("-translate-x-full", "opacity-0", "pointer-events-none");
    }
  });

  // Dropdown Menus
  const toggleBtn = document.getElementById("menu-toggle");
  const dropdown = document.getElementById("menu-dropdown");

  toggleBtn?.addEventListener("click", () => {
    dropdown?.classList.toggle("hidden");
  });

  // Dropdown Órdenes
  const ordenToggle = document.getElementById("ordenes-toggle");
  const ordenDropdown = document.getElementById("ordenes-dropdown");

  ordenToggle?.addEventListener("click", () => {
    ordenDropdown?.classList.toggle("hidden");
  });

  // Dropdown Facturación
  const facturacionToggle = document.getElementById("facturacion-toggle");
  const facturacionDropdown = document.getElementById("facturacion-dropdown");

  facturacionToggle?.addEventListener("click", () => {
    facturacionDropdown?.classList.toggle("hidden");
  });

  // Dropdown Suscripción
  const suscripcionToggle = document.getElementById("suscripcion-toggle");
  const suscripcionDropdown = document.getElementById("suscripcion-dropdown");

  suscripcionToggle?.addEventListener("click", () => {
    suscripcionDropdown?.classList.toggle("hidden");
  });

  // Dropdown Servicio
  const servicioToggle = document.getElementById("servicio-toggle");
  const servicioDropdown = document.getElementById("servicio-dropdown");

  servicioToggle?.addEventListener("click", () => {
    servicioDropdown?.classList.toggle("hidden");
  });

  // Dropdown Configuración
  const configToggle = document.getElementById("config-toggle");
  const configDropdown = document.getElementById("config-dropdown");

  configToggle?.addEventListener("click", () => {
    configDropdown?.classList.toggle("hidden");
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!toggleBtn?.contains(target) && !dropdown?.contains(target)) {
      dropdown?.classList.add("hidden");
    }
    if (!ordenToggle?.contains(target) && !ordenDropdown?.contains(target)) {
      ordenDropdown?.classList.add("hidden");
    }
    if (!facturacionToggle?.contains(target) && !facturacionDropdown?.contains(target)) {
      facturacionDropdown?.classList.add("hidden");
    }
    if (!suscripcionToggle?.contains(target) && !suscripcionDropdown?.contains(target)) {
      suscripcionDropdown?.classList.add("hidden");
    }
    if (!servicioToggle?.contains(target) && !servicioDropdown?.contains(target)) {
      servicioDropdown?.classList.add("hidden");
    }
    if (!configToggle?.contains(target) && !configDropdown?.contains(target)) {
      configDropdown?.classList.add("hidden");
    }
  });
</script>

