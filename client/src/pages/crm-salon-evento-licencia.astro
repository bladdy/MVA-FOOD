---
import LayoutMenu from "@/layouts/LayoutMenu.astro"
---

<LayoutMenu
  title="Cotización — Licencia CRM para Salón de Eventos"
  description="Cotización para adquisición de licencia, instalación y configuración de red local del CRM."
>

<!-- ========================================================= -->
<!-- CONTENEDOR GENERAL DEL DOCUMENTO -->
<!-- ========================================================= -->

<div id="documento-cotizacion">


  <!-- ======================================================= -->
  <!-- PÁGINA 1 -->
  <!-- ======================================================= -->

<article
  class="a4-page bg-white text-sm font-sans text-gray-900 border border-gray-300 flex flex-col"
>
    <!-- HEADER -->

    <header class="flex justify-between items-center mb-6 border-b pb-2">

      <div>

        <h1 class="text-2xl font-bold">
          COTIZACIÓN <span class="text-orange-600">0006</span>
        </h1>

        <p class="text-xs">
          12 de Agosto de 2026
        </p>

        <p class="text-xs mt-1">
          <strong>Vencimiento:</strong> 26 de Agosto de 2026
        </p>

      </div>


      <div class="text-right">

        <div class="mb-2 relative h-12">

          <img
            src="/ba-icon.png"
            alt="BlueArrow"
            class="h-12 mb-2 absolute top-0 right-2"
          />

        </div>

        <p class="text-lg font-bold text-orange-600">
          $15,000.00 MXN
        </p>

      </div>

    </header>


    <!-- CLIENTE -->

    <section class="mb-4">

      <div class="flex justify-between">

        <div>

          <p class="font-bold">
            Cliente
          </p>

          <p>
            Toldos Eventos
          </p>

          <p>
            Ciudad, Estado, México
          </p>

        </div>


        <div class="text-right">

          <p class="font-bold">
            Bladimir A. Almanzar V.
          </p>

          <p>
            Desarrollo de Software
          </p>

          <p>
            bladdy34@gmail.com
          </p>

        </div>

      </div>

    </section>


    <!-- DETALLE DE COTIZACIÓN -->

    <section class="mt-4">

      <table class="w-full border-collapse border text-xs">

        <thead class="bg-gray-100">

          <tr>

            <th class="border px-2 py-1 text-left">
              MÓDULOS
            </th>

            <th class="border px-2 py-1 text-left">
              DETALLES
            </th>

            <th class="border px-2 py-1">
              TOTAL DE LÍNEA
            </th>

          </tr>

        </thead>


        <tbody>


          <!-- LICENCIA -->

          <tr class="avoid-break">

            <td class="border px-2 py-1 align-top">

              Licencia CRM

            </td>


            <td class="border px-2 py-1">

              Licencia de uso del CRM especializado para salones de eventos<br>

              Gestión de clientes y eventos<br>

              Gestión del catálogo de servicios<br>

              Creación y administración de cotizaciones<br>

              Generación de facturas desde cotizaciones aprobadas<br>

              Registro de pagos y abonos<br>

              Estados de cotización: pendiente, aprobada y rechazada<br>

              Cálculo automático de subtotal, IVA y total<br>

              Licencia para instalación dentro de la infraestructura del cliente

            </td>


            <td class="border px-2 py-1 text-right whitespace-nowrap">

              $15,000.00 MXN

            </td>

          </tr>


          <!-- INSTALACIÓN Y RED -->

          <tr class="avoid-break">

            <td class="border px-2 py-1 align-top">

              Instalación y Configuración

            </td>


            <td class="border px-2 py-1">

              Instalación del CRM en servidor o equipo proporcionado por el cliente<br>

              Configuración de base de datos<br>

              Configuración inicial del sistema<br>

              Creación de usuarios iniciales<br>

              Configuración de empresa<br>

              Configuración de la red interna LAN<br>

              Configuración de acceso al CRM desde los equipos autorizados<br>

              Configuración básica de firewall y conectividad<br>

              Pruebas de conexión y funcionamiento<br>

              Puesta en funcionamiento del sistema

            </td>


            <td class="border px-2 py-1 text-right whitespace-nowrap">

              Incluida

            </td>

          </tr>


          <!-- CAPACITACIÓN -->

          <tr class="avoid-break">

            <td class="border px-2 py-1 align-top">

              Capacitación Inicial

            </td>


            <td class="border px-2 py-1">

              Capacitación para administrador y usuarios principales<br>

              Explicación del flujo de clientes<br>

              Creación de eventos<br>

              Creación de servicios<br>

              Elaboración de cotizaciones<br>

              Registro de pagos y facturación<br>

              Operación general del CRM

            </td>


            <td class="border px-2 py-1 text-right whitespace-nowrap">

              Incluida

            </td>

          </tr>


        </tbody>

      </table>

    </section>


    <!-- SERVICIOS OPCIONALES -->

    <section class="mt-5 avoid-break">

      <div class="flex items-center justify-between mb-2">

        <p class="font-bold text-sm">
          SERVICIOS OPCIONALES
        </p>

        <p class="text-xs text-gray-500">
          No incluidos en el total de la licencia
        </p>

      </div>


      <table class="w-full border-collapse border text-xs">

        <thead class="bg-gray-100">

          <tr>

            <th class="border px-2 py-1 text-left">
              SERVICIO
            </th>

            <th class="border px-2 py-1 text-left">
              FRECUENCIA
            </th>

            <th class="border px-2 py-1 text-right">
              PRECIO
            </th>

          </tr>

        </thead>


        <tbody>


          <!-- BACKUP -->

          <tr class="avoid-break">

            <td class="border px-2 py-1 align-top">

              Servicio de Respaldo (Backup)

            </td>


            <td class="border px-2 py-1">

              Mensual<br>
              Trimestral<br>
              Semestral

            </td>


            <td class="border px-2 py-1 text-right">

              $500.00 MXN / mes<br>
              $1,350.00 MXN / trimestre<br>
              $2,400.00 MXN / semestre

            </td>

          </tr>


          <!-- MANTENIMIENTO -->

          <tr class="avoid-break">

            <td class="border px-2 py-1 align-top">

              Mantenimiento de Equipos

            </td>


            <td class="border px-2 py-1">

              Mensual<br>
              Trimestral<br>
              Semestral

            </td>


            <td class="border px-2 py-1 text-right">

              $400.00 MXN / mes<br>
              $1,100.00 MXN / trimestre<br>
              $2,000.00 MXN / semestre

            </td>

          </tr>


        </tbody>

      </table>

    </section>


  </article>



  <!-- ======================================================= -->
  <!-- PÁGINA 2 -->
  <!-- ======================================================= -->

  <article
  class="a4-page bg-white text-sm font-sans text-gray-900 border border-gray-300 flex flex-col page-break"
>

    <div>


      <!-- HEADER PÁGINA 2 -->

      <header class="flex justify-between items-center mb-6 border-b pb-2">

        <div>

          <h1 class="text-2xl font-bold">
            COTIZACIÓN <span class="text-orange-600">0006</span>
          </h1>

          <p class="text-xs">
            Continuación de propuesta
          </p>

          <p class="text-xs mt-1">
            <strong>Licencia CRM para Salón de Eventos</strong>
          </p>

        </div>


        <div class="text-right">

          <div class="mb-2 relative h-12">

            <img
              src="/ba-icon.png"
              alt="BlueArrow"
              class="h-12 mb-2 absolute top-0 right-2"
            />

          </div>

          <p class="text-lg font-bold text-orange-600">
            $15,000.00 MXN
          </p>

        </div>

      </header>


      <!-- IDENTIFICADOR -->

      <section class="mb-5">

        <div class="flex justify-between">

          <div>

            <p class="font-bold">
              Cliente
            </p>

            <p>
              Toldos Eventos
            </p>

          </div>


          <div class="text-right">

            <p class="font-bold">
              Licencia + Implementación Local
            </p>

            <p>
              Cotización 0006
            </p>

          </div>

        </div>

      </section>


      <!-- CONDICIONES -->

      <section class="text-xs mt-4">

        <h2 class="text-sm font-bold mb-3 border-b pb-1">
          CONDICIONES DE LA PROPUESTA
        </h2>


        <div class="space-y-2">


          <p>

            <strong>
              Infraestructura:
            </strong>

            Servidor o equipo proporcionado por el cliente.

          </p>


          <p>

            <strong>
              Red interna:
            </strong>

            La configuración de la red LAN necesaria para el funcionamiento
            del CRM está incluida en la implementación inicial.

          </p>


          <p>

            <strong>
              Dominio:
            </strong>

            No incluido.

          </p>


          <p>

            <strong>
              Hosting / VPS:
            </strong>

            No incluido.

          </p>


          <p>

            <strong>
              Soporte inicial:
            </strong>

            30 días posteriores a la instalación.

          </p>


          <p>

            <strong>
              Actualizaciones mayores:
            </strong>

            Se cotizan por separado.

          </p>


          <p>

            <strong>
              Servicios opcionales:
            </strong>

            El servicio de backup y mantenimiento de equipos son opcionales
            y pueden contratarse de forma mensual, trimestral o semestral.

          </p>


        </div>

      </section>


      <!-- ALCANCE -->

      <section class="mt-6">

        <h2 class="text-sm font-bold mb-3 border-b pb-1">
          ALCANCE DE LA IMPLEMENTACIÓN
        </h2>


        <table class="w-full border-collapse border text-xs">

          <thead class="bg-gray-100">

            <tr>

              <th class="border px-2 py-1 text-left">
                ACTIVIDAD
              </th>

              <th class="border px-2 py-1 text-left">
                INCLUIDO
              </th>

            </tr>

          </thead>


          <tbody>

            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Instalación del CRM
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Configuración de base de datos
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Configuración de red LAN
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Configuración de equipos autorizados
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Configuración básica de firewall
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Capacitación inicial
              </td>

              <td class="border px-2 py-1">
                Sí
              </td>

            </tr>


            <tr class="avoid-break">

              <td class="border px-2 py-1">
                Soporte inicial
              </td>

              <td class="border px-2 py-1">
                30 días
              </td>

            </tr>

          </tbody>

        </table>

      </section>


      <!-- TOTALES -->

      <section class="mt-6 border-t pt-4 text-sm">

        <div class="grid grid-cols-2 gap-6">


          <!-- IZQUIERDA -->

          <div class="space-y-1 text-xs">

            <p>
              <strong>Impuestos incluidos:</strong> No
            </p>

            <p>
              <strong>Forma de pago:</strong>
              50% inicial / 50% contra entrega
            </p>

            <p>
              <strong>Tiempo estimado:</strong>
              15 a 20 días hábiles
            </p>

            <p>
              <strong>Servicios opcionales:</strong>
              No incluidos
            </p>

          </div>


          <!-- DERECHA -->

          <div class="space-y-1 text-right">


            <div class="flex justify-between">

              <span>
                <strong>Total Neto:</strong>
              </span>

              <span class="font-bold text-orange-600">
                $15,000.00 MXN
              </span>

            </div>


            <div class="flex justify-between">

              <span>
                <strong>Descuento:</strong>
              </span>

              <span class="font-bold text-orange-600">
                $0.00 MXN
              </span>

            </div>


            <div class="flex justify-between border-t pt-1">

              <span>
                <strong>Total Final:</strong>
              </span>

              <span class="font-bold text-orange-600">
                $15,000.00 MXN
              </span>

            </div>


          </div>

        </div>

      </section>


    </div>


    <!-- FOOTER -->

    <footer class="text-xs border-t pt-4 mt-5">

      <p class="mb-2">

        Esta cotización contempla la adquisición de una licencia del CRM
        especializado para salones de eventos, incluyendo la instalación,
        configuración inicial y configuración de la red interna necesaria
        para su operación dentro de la infraestructura proporcionada por
        el cliente.

      </p>


      <div class="bg-green-100 text-green-800 p-2 text-center font-semibold">

        El cliente adquiere la licencia del sistema y mantiene el control
        de la infraestructura donde será instalado. Los servicios de
        respaldo y mantenimiento de equipos son opcionales y pueden
        contratarse de acuerdo con las necesidades del cliente.

      </div>

    </footer>


  </article>

</div>


<!-- ========================================================= -->
<!-- BOTÓN DE IMPRESIÓN -->
<!-- ========================================================= -->

<div class="mt-6 text-center print:hidden">

  <button
    onclick="window.print()"
    class="bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2 px-4 rounded shadow"
  >

    🖨️ Imprimir Cotización

  </button>

</div>


</LayoutMenu>


<style is:global>

  /* ========================================================= */
  /* CONFIGURACIÓN GENERAL DE IMPRESIÓN */
  /* ========================================================= */

  @page {
    size: A4 portrait;
    margin: 0;
  }


  /* ========================================================= */
  /* PANTALLA */
  /* ========================================================= */

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #f1f1f1;
    font-family: 'Segoe UI', sans-serif;
  }


  /* ========================================================= */
  /* HOJA A4 */
  /* ========================================================= */

  .a4-page {

    width: 210mm;
    height: 297mm;
    min-height: 297mm;

    box-sizing: border-box;

    margin: 0 auto 24px auto;

    background: #ffffff;

    display: flex;
    flex-direction: column;

    overflow: hidden;

  }


  /* ========================================================= */
  /* TABLAS */
  /* ========================================================= */

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }


  /* ========================================================= */
  /* EVITAR CORTES DE FILAS */
  /* ========================================================= */

  tr {
    break-inside: avoid;
    page-break-inside: avoid;
  }


  .avoid-break {
    break-inside: avoid;
    page-break-inside: avoid;
  }


  /* ========================================================= */
  /* SEGUNDA PÁGINA */
  /* ========================================================= */

  .page-break {
    margin-top: 24px;
  }


  /* ========================================================= */
  /* IMPRESIÓN */
  /* ========================================================= */

  @media print {

    html,
    body {

      width: 210mm;
      height: auto;

      margin: 0 !important;
      padding: 0 !important;

      background: #ffffff !important;

    }


    /*
     * Ocultar TODO excepto
     * el documento de cotización.
     *
     * visibility deja el espacio ocupado en el flujo,
     * por eso se usa display:none en los hermanos del
     * documento (el documento es hijo directo del body).
     */

    body > :not(#documento-cotizacion) {
      display: none !important;
    }


    /*
     * El contenedor NO debe tener
     * altura ni padding.
     */

    #documento-cotizacion {

      width: 210mm;

      margin: 0 !important;
      padding: 0 !important;

      position: static;

    }


    /*
     * Cada article es exactamente
     * UNA hoja A4.
     */

    .a4-page {

      width: 210mm;
      height: 296mm;
      min-height: 296mm;

      margin: 0 !important;
      padding: 18mm;

      box-sizing: border-box;

      background: #ffffff !important;

      border: none !important;

      display: flex;
      flex-direction: column;

      overflow: hidden;

      /*
       * Mantener colores de Tailwind
       */

      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;

    }


    /*
     * La segunda hoja comienza
     * exactamente en la siguiente página.
     */

    .a4-page + .a4-page {

      break-before: page;
      page-break-before: always;

    }


    .page-break {

      margin: 0 !important;

      break-before: page;
      page-break-before: always;

    }


    /*
     * No generar página después
     * de la última hoja.
     */

    .a4-page:last-child {

      break-after: auto;
      page-break-after: auto;

    }


    /*
     * Las filas no se parten.
     */

    tr,
    .avoid-break {

      break-inside: avoid;
      page-break-inside: avoid;

    }


    /*
     * IMPORTANTE:
     *
     * NO utilizar:
     *
     * section,
     * header,
     * footer,
     * h1,
     * h2,
     * h3
     *
     * con break-inside: avoid.
     *
     * Eso puede provocar páginas
     * adicionales en Chrome.
     */


    /*
     * Ocultar botones.
     */

    .print\:hidden {

      display: none !important;
      visibility: hidden !important;

    }


    /*
     * Evitar que márgenes externos
     * generen espacio adicional.
     */

    #documento-cotizacion > .a4-page {

      margin-top: 0 !important;
      margin-bottom: 0 !important;

    }

  }


  /* ========================================================= */
  /* PANTALLAS PEQUEÑAS */
  /* ========================================================= */

  @media screen and (max-width: 850px) {

    .a4-page {

      width: 100%;
      height: auto;
      min-height: 0;

      margin-bottom: 24px;

      overflow: visible;

    }

  }

</style>