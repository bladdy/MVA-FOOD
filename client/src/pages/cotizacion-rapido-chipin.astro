---
import LayoutMenu from "@/layouts/LayoutMenu.astro"
---

<LayoutMenu
  title="Cotización para Diseño de Logo y Tarjeta de Presentación"
  description="Cotización para el diseño de logotipo y tarjeta de presentación."
>

<!-- Contenedor imprimible -->
<article
  id="cotizacion"
  class="a4-page p-5 bg-white text-sm font-sans text-gray-900 border border-gray-300 flex flex-col justify-between"
>

  <div>

    <!-- HEADER -->
    <header class="flex justify-between items-center mb-0 border-b pb-2">

      <div>

        <h1 class="text-2xl font-bold">
          COTIZACIÓN <span class="text-orange-600">0025</span>
        </h1>

        <p class="text-xs">
          12 de Agosto de 2026
        </p>

        <p class="text-xs mt-1">
          <strong>Vencimiento:</strong> 26 de Agosto de 2026
        </p>

      </div>


      <div class="text-right">

        <div class="mb-2 relative h-12">

          <img
            src="/ba-icon.png"
            alt="BlueArrow"
            class="h-12 mb-2 absolute top-0 right-2"
          />

        </div>

        <p class="text-lg font-bold text-orange-600">
          $125.00 USD
        </p>

      </div>

    </header>


    <!-- CLIENTE -->
    <section class="mb-4">

      <div class="flex justify-between">

        <div>

          <p class="font-bold">
            Cliente
          </p>

          <p>
            Junior Rosa
          </p>

          <p>
            Pensilvania, Estados Unidos
          </p>

        </div>


        <div class="text-right">

          <p class="font-bold">
            Bladimir A. Almanzar V.
          </p>

          <p>
            866-142-5258
          </p>

          <p>
            bladdy34@gmail.com
          </p>

        </div>

      </div>

    </section>


    <!-- DETALLE DE COTIZACIÓN -->
    <section class="mt-4">

      <table class="w-full border-collapse border text-xs">

        <thead class="bg-gray-100">

          <tr>

            <th class="border px-2 py-1 text-left">
              MÓDULOS
            </th>

            <th class="border px-2 py-1 text-left">
              DETALLES
            </th>

            <th class="border px-2 py-1">
              TOTAL DE LÍNEA
            </th>

          </tr>

        </thead>


        <tbody>

          <!-- LOGO -->
          <tr>

            <td class="border px-2 py-1 align-top">

              Diseño de Logotipo

            </td>


            <td class="border px-2 py-1">

              Diseño de logotipo personalizado<br>

              Análisis de la actividad y estilo del negocio<br>

              Propuesta de concepto visual<br>

              Diseño de logotipo principal<br>

              Selección de colores corporativos<br>

              Selección de tipografía<br>

              Hasta 2 propuestas iniciales<br>

              Hasta 2 rondas de modificaciones<br>

              Entrega en formatos PNG, PDF y SVG

            </td>


            <td class="border px-2 py-1 text-right">

              $100.00 USD

            </td>

          </tr>


          <!-- TARJETA -->
          <tr>

            <td class="border px-2 py-1 align-top">

              Tarjeta de Presentación

            </td>


            <td class="border px-2 py-1">

              Diseño personalizado de tarjeta de presentación<br>

              Diseño de frente y reverso<br>

              Integración del nuevo logotipo<br>

              Aplicación de colores corporativos<br>

              Distribución profesional de información<br>

              Diseño optimizado para impresión<br>

              Hasta 2 rondas de modificaciones<br>

              Entrega en formato PDF, PNG y JPG

            </td>


            <td class="border px-2 py-1 text-right">

              $75.00 USD

            </td>

          </tr>


          <!-- ARCHIVOS FINALES -->
          <tr>

            <td class="border px-2 py-1 align-top">

              Archivos Finales

            </td>


            <td class="border px-2 py-1">

              Preparación de archivos finales<br>

              Versiones del logotipo para diferentes usos<br>

              Archivos optimizados para impresión y uso digital

            </td>


            <td class="border px-2 py-1 text-right">

              $25.00 USD

            </td>

          </tr>

        </tbody>

      </table>

    </section>


    <!-- CONDICIONES -->
    <section class="text-xs mt-6">

      <p>
        <strong>Tiempo estimado de entrega:</strong>
        5 a 7 días hábiles
      </p>

      <p>
        <strong>
          Hasta 2 rondas de modificaciones incluidas por cada etapa.
        </strong>
      </p>

      <p>
        <strong>
          7 días de soporte post-entrega gratis.
        </strong>
      </p>

      <p class="text-red-600 mt-2 hidden">
        *Descuento del 20% aplicable por pago anticipado
      </p>

    </section>


    <!-- TOTALES -->
    <section class="mt-4 border-t pt-4 text-sm">

      <div class="grid grid-cols-2 gap-6">


        <!-- IZQUIERDA -->

        <div class="space-y-1 text-xs">

          <p>
            Impuestos incluidos: No aplica
          </p>

          <p>
            Forma de pago: 100% inicial
          </p>

          <p>
            Impresión física: No incluida
          </p>

        </div>


        <!-- DERECHA -->

        <div class="space-y-1 text-right">


          <!-- TOTAL NETO -->

          <div class="flex justify-between">

            <span>
              <strong>Total Neto:</strong>
            </span>

            <span class="font-bold text-orange-600">
              $200.00 USD
            </span>

          </div>


          <!-- DESCUENTO -->

          <div class="flex justify-between">

            <span>
              <strong>Descuento:</strong>
            </span>

            <span class="font-bold text-orange-600">
              -$75.00 USD
            </span>

          </div>


          <!-- TOTAL FINAL -->

          <div class="flex justify-between border-t pt-1">

            <span>
              <strong>Total Final:</strong>
            </span>

            <span class="font-bold text-orange-600">
              $125.00 USD
            </span>

          </div>


        </div>

      </div>

    </section>

    <!-- FOOTER -->
  
    <footer class="text-xs border-t pt-4 mt-0">
  
      <p class="mb-2">
  
        Esta cotización incluye el diseño del logotipo y tarjeta de presentación
        según las especificaciones acordadas con el cliente.
  
      </p>
  
  
      <div class="bg-green-100 text-green-800 p-2 text-center font-semibold">
  
        Esta cotización incluye diseño personalizado, modificaciones,
        preparación de archivos y entrega digital lista para impresión.
  
      </div>
  
    </footer>
  </div>




</article>


<!-- BOTÓN DE IMPRESIÓN -->

<div class="mt-6 text-center print:hidden">

  <button
    onclick="window.print()"
    class="bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2 px-4 rounded shadow"
  >

    🖨️ Imprimir Cotización

  </button>

</div>


</LayoutMenu>


<style is:global>

  @media print {

    body * {
      visibility: hidden;
    }

    #cotizacion,
    #cotizacion * {
      visibility: visible;
    }

    #cotizacion {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
    }

    .print\:hidden {
      display: none !important;
    }

  }


  body {
    background-color: #f1f1f1;
    font-family: 'Segoe UI', sans-serif;
  }


  .a4-page {
    width: 210mm;
    min-height: 297mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: auto;
    background: white;
  }


  table {
    font-size: 0.85rem;
  }

</style>